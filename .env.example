# ---------------------------------------------------------------------------
# Birthday Bot — environment
# Copy to .env for local development; set the same keys as Railway variables.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# On Railway: add a Postgres service, then reference it from the app service as
#   DATABASE_URL = ${{ Postgres.DATABASE_URL }}
DATABASE_URL="postgresql://user:password@host:5432/birthday_bot"

# Web Push VAPID keypair. Generate once with:  npm run vapid
# Both are base64url, so they are safe inside a .env file (a `$` in a secret is
# eaten by dotenv expansion — these never contain one).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Contact for the push services, as a mailto: or https: URL. Required by VAPID.
VAPID_SUBJECT="mailto:you@example.com"

# The zone every "today" is computed in. A Railway container has no TZ and runs
# UTC, so this is derived in code from a named zone rather than the OS clock.
APP_TIMEZONE="America/Toronto"

# Hour of the day (0-23, in APP_TIMEZONE) the reminder job fires. Default 8.
NOTIFY_HOUR=8

# Railway injects PORT. Locally it defaults to 8080.
# PORT=8080
