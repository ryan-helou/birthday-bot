{
  "name": "birthday-bot",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && vite build --config client/vite.config.js && node scripts/stamp-sw.mjs",
    "start": "prisma migrate deploy && node server/index.js",
    "server": "node server/index.js",
    "vapid": "node scripts/generate-vapid.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node --test --test-concurrency=1 tests/",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "PWA birthday tracker with automated Web Push reminders",
  "private": "true",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "railway": "^3.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
